---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config';
import Departments from '../markdown/departments.md';

const socialLinks = [
  {
    label: 'Bilibili',
    href: 'https://space.bilibili.com/3632313615256374',
    icon: 'bilibili',
  },
  {
    label: '微信公众号',
    href: 'https://mp.weixin.qq.com/s/JEQ_mOdutMnV17chkp6JZQ',
    icon: 'wechat',
  },
  {
    label: 'QQ 群',
    href: 'https://qm.qq.com/q/bhJtg9qyCA',
    icon: 'qq',
  },
];
---

<BaseLayout title={siteConfig.title}>
  <Navigation />

  <main class="container home">
    <section class="hero">
      <h1>{siteConfig.title}</h1>
      <p class="hero-slogan">全心求索，同道而思</p>
      <p class="hero-intro">
        索思科技协会成立于1991年，历经三十余载沉淀，已成长为北科历史最悠久、影响力最为深远的学术科技类社团之一。
      </p>

      <div class="hero-social" aria-label="社交媒体">
        {socialLinks.map(link => (
          <a class="hero-social-link" href={link.href} target="_blank" rel="noopener noreferrer" aria-label={link.label}>
            <svg class="hero-social-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {link.icon === 'bilibili' && (
                <>
                  <rect x="2" y="7" width="20" height="15" rx="2" ry="2" />
                  <polyline points="17 2 12 7 7 2" />
                </>
              )}
              {link.icon === 'wechat' && (
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
              )}
              {link.icon === 'qq' && (
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
              )}
            </svg>
            <span>{link.label}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="about" aria-labelledby="about-heading">
      <h2 class="section-heading" id="about-heading">社团简介</h2>

      <figure class="about-photo">
        <img
          src="/images/club/group-photo.jpg"
          alt="2025年秋北京科技大学索思科技协会合影留念"
          width="1080"
          height="608"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="about-copy">
        <p>
          协会下设办公室、学术部、宣传部、技术部四大职能部门，并搭建功能型团支部与竞赛团队联盟；汇聚百余名跨年级、跨学院的科创爱好者，致力于打通课堂理论与科技实践之间的壁垒。
        </p>
      </div>

      <figure class="about-chart">
        <img
          src="/images/club/org-chart.png"
          alt="索思科技协会组织架构：主席团下设办公室、宣传部、学术部、技术部，技术部下设技术宣传组、运维保障组、游戏开发组、硬件开发组、项目研发组和 B06 创新实验室"
          width="1080"
          height="310"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="about-copy">
        <p>
          索思近年来先后获评2025年首都高校“学生最喜爱的社团”、北科“87级校友基金”优秀学生社团、第八届“计通之光”计通先锋，连续四年获评iCAN大赛“十佳创新社团”，并拥有校“团内百优”优秀团支部、华为智能基座“披荆斩棘奖”等荣誉。
        </p>
        <p>
          成员累计获得200余项竞赛奖项，其中国家级50余项、省部级100余项，并产出多篇学术论文与在审发明专利；多名社员跻身年级前列，获得国家奖学金。
        </p>
      </div>
    </section>

    <section class="departments">
      <Departments />
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .home {
    padding-top: 6rem;
  }

  .hero {
    padding: 2.5rem 0 1rem;
    text-align: center;
  }

  .hero h1 {
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    margin-bottom: 1.25rem;
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-hover));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-slogan {
    color: var(--home-intro-color);
    font-size: clamp(1.1rem, 2.5vw, 1.35rem);
    font-weight: 500;
    letter-spacing: 0.12em;
    margin-bottom: 1rem;
  }

  .hero-intro {
    color: var(--home-intro-color);
    font-size: 1rem;
    line-height: 1.9;
    max-width: 640px;
    margin: 0 auto;
  }

  .hero-social {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 0.4rem 1.5rem;
    max-width: 640px;
    margin: 1.5rem auto 0;
    text-align: left;
  }

  .hero-social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--text-secondary);
    font-size: 0.875rem;
    font-weight: 500;
    transition: color var(--transition-fast);
  }

  .hero-social-link:hover {
    color: var(--color-primary);
  }

  .hero-social-icon {
    flex-shrink: 0;
  }

  .about {
    max-width: 800px;
    margin: 0 auto;
    padding-top: 3.5rem;
  }

  .section-heading {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .section-heading::before {
    content: '';
    width: 4px;
    height: 1.15em;
    border-radius: 9999px;
    background: var(--color-primary);
  }

  .about-photo,
  .about-chart {
    margin: 0 0 1.5rem;
    border: 1px solid var(--border-color);
    border-radius: 16px;
    overflow: hidden;
    background: #ffffff;
  }

  .about-photo img,
  .about-chart img {
    display: block;
    width: 100%;
    height: auto;
  }

  .about-chart {
    padding: 1.25rem;
  }

  .about-copy {
    margin-bottom: 1.5rem;
  }

  .about-copy p {
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.95;
    margin: 0 0 1rem;
  }

  .about-copy p:last-child {
    margin-bottom: 0;
  }


  .departments {
    max-width: 800px;
    margin: 3.5rem auto 0;
  }

  .departments :global(h1) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1.25rem;
    margin: 0 0 1.5rem;
  }

  .departments :global(h1)::before {
    content: '';
    width: 4px;
    height: 1.15em;
    border-radius: 9999px;
    background: var(--color-primary);
  }

  .departments :global(.dept-photo) {
    margin: 1rem 0 1.25rem;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    overflow: hidden;
  }

  .departments :global(.dept-photo img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .departments :global(h2) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 2rem 0 0.5rem;
    font-size: 1.15rem;
    color: var(--text-primary);
  }

  .departments :global(h2)::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-primary);
  }

  .departments :global(h3) {
    margin: 1.5rem 0 0.35rem;
    font-size: 1.05rem;
    color: var(--text-primary);
  }

  .departments :global(p) {
    margin: 0 0 0.75rem;
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.9;
  }

  .departments :global(p:last-child) {
    margin-bottom: 0;
  }

  @media (max-width: 520px) {
    .departments {
      margin-top: 2.5rem;
    }
  }

  @media (max-width: 640px) {
    .about-chart {
      overflow-x: auto;
      overflow-y: hidden;
    }

    .about-chart img {
      min-width: 680px;
    }
  }

  @media (max-width: 520px) {
    .about {
      padding-top: 2.5rem;
    }

    .about-photo,
    .about-chart {
      border-radius: 12px;
    }

    .about-chart {
      padding: 0.75rem;
    }
  }
</style>
