---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config';

const socialLinks = [
  {
    label: 'Bilibili',
    href: 'https://space.bilibili.com/3632313615256374',
    icon: 'bilibili',
  },
  {
    label: '微信公众号',
    href: 'https://mp.weixin.qq.com/s/JEQ_mOdutMnV17chkp6JZQ',
    icon: 'wechat',
  },
  {
    label: 'QQ 群',
    href: 'https://qm.qq.com/q/bhJtg9qyCA',
    icon: 'qq',
  },
];
---

<BaseLayout title={siteConfig.title}>
  <Navigation />

  <main class="container home">
    <section class="hero">
      <h1>{siteConfig.title}</h1>
      <p class="hero-slogan">全心求索，同道而思</p>
      <p class="hero-intro">
        索思科技协会成立于1991年，历经三十余载沉淀，已成长为北科历史最悠久、影响力最为深远的学术科技类社团之一。
      </p>

      <div class="hero-social" aria-label="社交媒体">
        {socialLinks.map(link => (
          <a class="hero-social-link" href={link.href} target="_blank" rel="noopener noreferrer" aria-label={link.label}>
            <svg class="hero-social-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {link.icon === 'bilibili' && (
                <>
                  <rect x="2" y="7" width="20" height="15" rx="2" ry="2" />
                  <polyline points="17 2 12 7 7 2" />
                </>
              )}
              {link.icon === 'wechat' && (
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
              )}
              {link.icon === 'qq' && (
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
              )}
            </svg>
            <span>{link.label}</span>
          </a>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .home {
    padding-top: 6rem;
  }

  .hero {
    padding: 2.5rem 0 1rem;
    text-align: center;
  }

  .hero h1 {
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    margin-bottom: 1.25rem;
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-hover));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-slogan {
    color: var(--home-intro-color);
    font-size: clamp(1.1rem, 2.5vw, 1.35rem);
    font-weight: 500;
    letter-spacing: 0.12em;
    margin-bottom: 1rem;
  }

  .hero-intro {
    color: var(--home-intro-color);
    font-size: 1rem;
    line-height: 1.9;
    max-width: 640px;
    margin: 0 auto;
  }

  .hero-social {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 0.4rem 1.5rem;
    max-width: 640px;
    margin: 1.5rem auto 0;
    text-align: left;
  }

  .hero-social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--text-secondary);
    font-size: 0.875rem;
    font-weight: 500;
    transition: color var(--transition-fast);
  }

  .hero-social-link:hover {
    color: var(--color-primary);
  }

  .hero-social-icon {
    flex-shrink: 0;
  }
</style>
